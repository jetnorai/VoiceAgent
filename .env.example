# Server
PORT=3040
DRAIN_TIMEOUT=300

# Twilio (Voice)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_PUBLIC_URL=https://your-public-url.example.com

# Speech-to-Text (Deepgram Flux)
DEEPGRAM_API_KEY=your_deepgram_api_key

# LLM
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_api_key

# Text-to-Speech (ElevenLabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=ZF6FPAbjXT4488VcRRnw

# Email Notifications (Resend)
RESEND_API_KEY=your_resend_api_key
BUSINESS_EMAIL=info@imperiumdecorating.com

# Google Calendar
GOOGLE_CALENDAR_ID=your_google_calendar_id
# Option A: base64-encoded service account JSON (recommended for production/cloud deployments)
#   Generate with: base64 -w0 google_credentials.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option B: path to service account JSON file (for local development)
#   The file google_credentials.json is git-ignored — never commit it
GOOGLE_CREDENTIALS_FILE=google_credentials.json
